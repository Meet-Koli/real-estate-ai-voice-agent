      "parameters": {
        "jsCode": "// Get inputs directly (from Extract Tool Data node)\nconst filters = $json;\n\n// Get all properties\nconst properties = items.map(item => item.json);\n\n// Step 1: Filter (basic)\nlet filtered = properties.filter(p => {\n\n  const locationMatch = !filters.location || \n    p.location?.toLowerCase().includes(filters.location.toLowerCase());\n\n  const budgetMatch = !filters.budget_max || \n    Number(p.price) <= Number(filters.budget_max);\n\n  return locationMatch && budgetMatch;\n});\n\n// Step 2: Score each property\nfiltered = filtered.map(p => {\n  let score = 0;\n\n  if (p.location?.toLowerCase().includes(filters.location?.toLowerCase())) score += 50;\n\n  if (filters.bedrooms && Number(p.bedrooms) === Number(filters.bedrooms)) score += 20;\n\n  if (filters.property_type && \n      p.property_type?.toLowerCase() === filters.property_type.toLowerCase()) score += 15;\n\n  if (Number(p.price) <= Number(filters.budget_max)) score += 15;\n\n  return { ...p, score };\n});\n\n// Step 3: Sort\nfiltered.sort((a, b) => b.score - a.score);\n\n// Step 4: Top 3\nfiltered = filtered.slice(0, 3);\n\n// Step 5: Fallback\nif (filtered.length === 0) {\n  return [{\n    json: {\n      message: \"I couldn’t find exact matches, but I can suggest similar options if you'd like.\"\n    }\n  }];\n}\n\n// Step 6: Return clean results\nreturn filtered.map(p => ({\n  json: {\n    location: p.location,\n    price: p.price,\n    bedrooms: p.bedrooms,\n    property_type: p.property_type,\n    score: p.score\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
