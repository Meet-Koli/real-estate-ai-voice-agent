    {
      "parameters": {
        "jsCode": "const rawDate = ($json.date || \"\").toLowerCase();\nconst rawTime = ($json.time || \"\").toLowerCase();\n\nconst now = new Date();\nlet parsedDate = new Date();\n\n// --- DAY PARSING ---\n\nconst days = {\n  sunday: 0,\n  monday: 1,\n  tuesday: 2,\n  wednesday: 3,\n  thursday: 4,\n  friday: 5,\n  saturday: 6\n};\n\nif (rawDate.includes(\"tomorrow\")) {\n  parsedDate.setDate(now.getDate() + 1);\n}\nelse if (rawDate.includes(\"today\")) {\n  parsedDate = now;\n}\nelse if (rawDate.includes(\"next\")) {\n  const dayName = Object.keys(days).find(d => rawDate.includes(d));\n  if (dayName) {\n    const targetDay = days[dayName];\n    const currentDay = now.getDay();\n    let diff = targetDay - currentDay;\n\n    if (diff <= 0) diff += 7;\n    diff += 7; // next week\n\n    parsedDate.setDate(now.getDate() + diff);\n  }\n}\nelse {\n  // fallback\n  const tryDate = new Date(rawDate);\n  if (!isNaN(tryDate)) parsedDate = tryDate;\n}\n\n// --- TIME PARSING ---\n\nlet parsedTime = \"12:00\"; // default\n\nif (rawTime.includes(\"morning\")) parsedTime = \"10:00\";\nelse if (rawTime.includes(\"afternoon\")) parsedTime = \"14:00\";\nelse if (rawTime.includes(\"evening\")) parsedTime = \"18:00\";\nelse if (rawTime.includes(\"night\")) parsedTime = \"20:00\";\nelse {\n  // handle \"5 pm\", \"12 pm\"\n  const match = rawTime.match(/(\\d+)(:\\d+)?\\s*(am|pm)/);\n  if (match) {\n    let hour = parseInt(match[1]);\n    const isPM = match[3] === \"pm\";\n\n    if (isPM && hour !== 12) hour += 12;\n    if (!isPM && hour === 12) hour = 0;\n\n    parsedTime = `${hour.toString().padStart(2, '0')}:00`;\n  }\n}\n\n// --- FINAL FORMAT ---\n\nconst formattedDate = parsedDate.toISOString().split('T')[0];\n\nreturn [\n  {\n    json: {\n      ...$json,\n      date_parsed: formattedDate,\n      time_parsed: parsedTime,\n      date_raw: $json.date,\n      time_raw: $json.time\n    }\n  }\n];"
